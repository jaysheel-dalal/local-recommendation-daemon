@PACKAGE_INIT@

# Consumers link lrd::sdk. Its dependencies are PRIVATE, but a static library
# still needs them resolved at the consumer's link step, so anything the
# archives reference has to be findable from here.
include(CMakeFindDependencyMacro)

find_dependency(Threads)

# Only when the SDK was built with protobuf support: liblrd_proto_gen links
# protobuf::libprotobuf, and that imported target has to exist before
# lrdTargets.cmake references it.
set(LRD_WITH_PROTOBUF @LRD_WITH_PROTOBUF@)
if(LRD_WITH_PROTOBUF)
    find_dependency(Protobuf MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/lrdTargets.cmake")

check_required_components(lrd)
